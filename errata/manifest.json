{
  "manifest_version": 3,
  "name": "Errata",
  "version": "0.1.0",
  "description": "Collect website text corrections like an editor's errata list: click any text, propose a correction, capture a screenshot, and export the proposals as a report.",
  "permissions": ["storage", "unlimitedStorage", "downloads", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Errata",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["picker.js"],
      "run_at": "document_idle"
    }
  ]
}
